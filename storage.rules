rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Proof of payment uploads — only the uploader or leaders/admins can read
    match /pop/{userId}/{fileName} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'leader']
      );
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/jpeg|image/png|application/pdf');
    }

    // Leadership documents — leaders and admins only
    match /documents/{fileName} {
      allow read: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'leader'];
      allow write: if false;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
