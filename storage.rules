rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Proof of payment uploads — authenticated users can upload to their own folder only
    match /pop/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024  // 5 MB max
                   && request.resource.contentType.matches('image/jpeg|image/png|application/pdf');
    }

    // Leadership documents — authenticated users can download, no uploads from app
    match /documents/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
