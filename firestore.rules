rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.role == 'admin' && u.status == 'approved';
    }

    function isLeaderOrAdmin() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.status == 'approved' && u.role in ['admin', 'leader'];
    }

    function isChangingProtectedField() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'status', 'approvedAt']);
    }

    // Shared shape check for a giving/tithe transaction doc — used by both
    // the per-user givingHistory subcollection and the global
    // givingTransactions collection so a client can't write a negative,
    // zero, or already-settled donation record.
    function isValidGivingWrite() {
      return request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentMethod == 'eft';
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isLeaderOrAdmin());

      // Self-registration: enforce correct status for chosen role
      allow create: if isAuthenticated() && isOwner(userId) && (
        (request.resource.data.role == 'member'  && request.resource.data.status == 'approved') ||
        (request.resource.data.role in ['leader', 'admin'] && request.resource.data.status == 'pending')
      );

      // Users can update their own profile but cannot touch protected fields
      allow update: if isAuthenticated() && isOwner(userId) && !isChangingProtectedField();

      // Admins can update anything (approval, role changes)
      allow update: if isAdmin();

      allow delete: if false;

      match /givingHistory/{transactionId} {
        allow read:   if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId) && isValidGivingWrite();
      }

      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && isOwner(userId);
        // System/reviewer-triggered only (registration approval, POP review,
        // etc.) — never self-service, and shape-restricted.
        allow create: if (
            isAdmin() ||
            (isLeaderOrAdmin() &&
              get(/databases/$(database)/documents/users/$(userId)).data.congregation ==
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.congregation)
          )
          && request.resource.data.read == false
          && request.resource.data.type is string
          && request.resource.data.title is string
          && request.resource.data.body is string;
        // Only allow marking as read — no other field changes
        allow update: if isAuthenticated() && isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();

      // A member registering for an event bumps the counter — scoped to
      // exactly that single-field, single-step increment, and only once
      // their own registration doc for this event actually exists
      // (registerForEvent creates the registration before incrementing).
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeCount'])
        && request.resource.data.attendeeCount == resource.data.attendeeCount + 1
        && exists(/databases/$(database)/documents/eventRegistrations/$(request.auth.uid + '_' + eventId));
    }

    match /districts/{districtId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Admin notification feed (created by app on registration)
    match /notifications/{notificationId} {
      allow read:   if isAdmin();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }

    match /documents/{documentId} {
      allow read: if isLeaderOrAdmin();
      allow write: if isAdmin();
    }

    // Global giving analytics
    match /givingTransactions/{transactionId} {
      allow read: if isAdmin();

      // Signed-in members
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.isAnonymous == false
        && isValidGivingWrite();

      // Unauthenticated visitors: no auth to check, so lock the write down
      // to the exact anonymous shape the app sends — no arbitrary fields,
      // no impersonating a real userId.
      allow create: if !isAuthenticated()
        && request.resource.data.userId == null
        && request.resource.data.isAnonymous == true
        && isValidGivingWrite();
    }

    match /prayerRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid;
      // Praying toggles exactly one step: the caller adds themself (count +1)
      // or removes themself (count -1). Values are validated, not just keys,
      // so a crafted write can't inflate the counter or edit other people's
      // entries in prayingBy.
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['prayCount', 'prayingBy'])
        && (
          (
            request.resource.data.prayCount == resource.data.prayCount + 1
            && request.resource.data.prayingBy.size() == resource.data.prayingBy.size() + 1
            && request.resource.data.prayingBy.hasAll(resource.data.prayingBy)
            && request.auth.uid in request.resource.data.prayingBy
            && !(request.auth.uid in resource.data.prayingBy)
          ) || (
            request.resource.data.prayCount == resource.data.prayCount - 1
            && request.resource.data.prayingBy.size() == resource.data.prayingBy.size() - 1
            && resource.data.prayingBy.hasAll(request.resource.data.prayingBy)
            && request.auth.uid in resource.data.prayingBy
            && !(request.auth.uid in request.resource.data.prayingBy)
          )
        );
      allow delete: if isAuthenticated() && isOwner(resource.data.createdBy);
    }

    match /eventRegistrations/{registrationId} {
      // Admins see every registration; leaders only their own congregation's;
      // the registering member can always see their own.
      allow read: if isAdmin() || isOwner(resource.data.userId) || (
        isLeaderOrAdmin() &&
        resource.data.congregation == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.congregation
      );

      // Registering — doc id is `${uid}_${eventId}` so a member can't
      // create a registration under another event/user's id, and status
      // must match whether the event actually requires payment.
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && registrationId == request.auth.uid + '_' + request.resource.data.eventId
        && (
          (request.resource.data.requiresPayment == true  && request.resource.data.status == 'awaiting_payment') ||
          (request.resource.data.requiresPayment == false && request.resource.data.status == 'confirmed')
        );

      // Owner submits or resubmits payment proof after a rejection
      // (mirrored by merchOrders below).
      allow update: if isAuthenticated() && isOwner(resource.data.userId)
        && resource.data.status in ['awaiting_payment', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fileUrl', 'fileName', 'mimeType', 'status', 'paymentSubmittedAt', 'rejectionReason'])
        && request.resource.data.status == 'payment_submitted';

      // Admin/leader reviews
      allow update: if (
          isAdmin() ||
          (isLeaderOrAdmin() &&
            resource.data.congregation == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.congregation)
        )
        && resource.data.status == 'payment_submitted'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'rejectionReason'])
        && request.resource.data.status in ['approved', 'rejected'];

      allow delete: if false;
    }

    match /merchandise/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /merchOrders/{orderId} {
      allow read: if isAdmin() || isOwner(resource.data.userId) || (
        isLeaderOrAdmin() &&
        resource.data.congregation == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.congregation
      );
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'awaiting_payment';
      // Owner attaches payment proof, or resubmits after a rejection —
      // same flow as eventRegistrations.
      allow update: if isAuthenticated() && isOwner(resource.data.userId)
        && resource.data.status in ['awaiting_payment', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fileUrl', 'fileName', 'mimeType', 'status', 'paymentSubmittedAt', 'rejectionReason'])
        && request.resource.data.status == 'payment_submitted';
      // Admin/leader reviews
      allow update: if (
          isAdmin() ||
          (isLeaderOrAdmin() &&
            resource.data.congregation == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.congregation)
        )
        && resource.data.status == 'payment_submitted'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'rejectionReason'])
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if false;
    }

    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Live-stream banner is shown on the Media tab, which visitors can see
    // without signing in — this doc needs to be readable without auth.
    match /config/liveStatus {
      allow read: if true;
    }
  }
}
